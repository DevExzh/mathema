{
  "name": "mathema-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "SvelteKit web app for the Mathema formula renderer and converter (WebAssembly).",
  "scripts": {
    "wasm": "wasm-pack build .. --target web --out-dir web/src/lib/wasm --release -- --no-default-features --features \"wasm render\"",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.0.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
