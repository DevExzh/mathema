{
  "name": "mathema-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "description": "SvelteKit web app for the Mathema formula renderer and converter (WebAssembly).",
  "scripts": {
    "wasm": "wasm-pack build .. --target web --out-dir web/src/lib/wasm --release -- --no-default-features --features \"wasm render\"",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
