{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*.js", "src/**/*.svelte", ".svelte-kit/ambient.d.ts"],
  "exclude": ["node_modules", "build", ".svelte-kit/output"]
}
