<m:oMathPara xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <m:oMathParaPr>
    <m:jc m:val="left"/>
  </m:oMathParaPr>
  <m:oMath>
    <m:r>
      <w:rPr>
        <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
      </w:rPr>
      <m:t>f</m:t>
    </m:r>
    <m:d>
      <m:dPr>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:dPr>
      <m:e>
        <m:r>
          <m:t>x</m:t>
        </m:r>
      </m:e>
    </m:d>
    <m:r>
      <m:t>=</m:t>
    </m:r>
    <m:d>
      <m:dPr>
        <m:begChr m:val="{"/>
        <m:endChr m:val=""/>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:dPr>
      <m:e>
        <m:eqArr>
          <m:eqArrPr>
            <m:ctrlPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
                <w:i/>
              </w:rPr>
            </m:ctrlPr>
          </m:eqArrPr>
          <m:e>
            <m:r>
              <m:t>x</m:t>
            </m:r>
            <m:r>
              <m:rPr>
                <m:nor/>
              </m:rPr>
              <w:rPr>
                <w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/>
              </w:rPr>
              <m:t xml:space="preserve">  if </m:t>
            </m:r>
            <m:r>
              <m:t>x≥0</m:t>
            </m:r>
          </m:e>
          <m:e>
            <m:r>
              <m:t>−x</m:t>
            </m:r>
            <m:r>
              <m:rPr>
                <m:nor/>
              </m:rPr>
              <m:t xml:space="preserve">  otherwise</m:t>
            </m:r>
          </m:e>
        </m:eqArr>
      </m:e>
    </m:d>
  </m:oMath>
  <m:oMath>
    <m:func>
      <m:funcPr>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
          </w:rPr>
        </m:ctrlPr>
      </m:funcPr>
      <m:fName>
        <m:limLow>
          <m:limLowPr>
            <m:ctrlPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
              </w:rPr>
            </m:ctrlPr>
          </m:limLowPr>
          <m:e>
            <m:r>
              <m:rPr>
                <m:sty m:val="p"/>
              </m:rPr>
              <m:t>lim</m:t>
            </m:r>
          </m:e>
          <m:lim>
            <m:r>
              <m:t>n→∞</m:t>
            </m:r>
          </m:lim>
        </m:limLow>
      </m:fName>
      <m:e>
        <m:sSup>
          <m:sSupPr>
            <m:ctrlPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
                <w:i/>
              </w:rPr>
            </m:ctrlPr>
          </m:sSupPr>
          <m:e>
            <m:d>
              <m:e>
                <m:r>
                  <m:t>1+</m:t>
                </m:r>
                <m:f>
                  <m:fPr>
                    <m:type m:val="skw"/>
                  </m:fPr>
                  <m:num>
                    <m:r>
                      <m:t>1</m:t>
                    </m:r>
                  </m:num>
                  <m:den>
                    <m:r>
                      <m:t>n</m:t>
                    </m:r>
                  </m:den>
                </m:f>
              </m:e>
            </m:d>
          </m:e>
          <m:sup>
            <m:r>
              <m:t>n</m:t>
            </m:r>
          </m:sup>
        </m:sSup>
      </m:e>
    </m:func>
    <m:r>
      <m:t>=</m:t>
    </m:r>
    <m:r>
      <w:rPr>
        <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
        <w:color w:val="C00000"/>
      </w:rPr>
      <m:t>e</m:t>
    </m:r>
  </m:oMath>
  <m:oMath>
    <m:nary>
      <m:naryPr>
        <m:limLoc m:val="subSup"/>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:naryPr>
      <m:sub>
        <m:r>
          <m:t>0</m:t>
        </m:r>
      </m:sub>
      <m:sup>
        <m:r>
          <m:t>π</m:t>
        </m:r>
      </m:sup>
      <m:e>
        <m:func>
          <m:funcPr>
            <m:ctrlPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
                <w:i/>
              </w:rPr>
            </m:ctrlPr>
          </m:funcPr>
          <m:fName>
            <m:r>
              <m:rPr>
                <m:sty m:val="p"/>
              </m:rPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
              </w:rPr>
              <m:t>sin</m:t>
            </m:r>
          </m:fName>
          <m:e>
            <m:r>
              <m:t>x</m:t>
            </m:r>
          </m:e>
        </m:func>
        <m:box>
          <m:boxPr>
            <m:diff m:val="1"/>
            <m:ctrlPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
                <w:i/>
              </w:rPr>
            </m:ctrlPr>
          </m:boxPr>
          <m:e>
            <m:r>
              <m:rPr>
                <m:sty m:val="p"/>
              </m:rPr>
              <m:t>d</m:t>
            </m:r>
            <m:r>
              <m:t>x</m:t>
            </m:r>
          </m:e>
        </m:box>
      </m:e>
    </m:nary>
    <m:r>
      <m:t>=</m:t>
    </m:r>
    <m:rad>
      <m:radPr>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:radPr>
      <m:deg>
        <m:r>
          <m:t>3</m:t>
        </m:r>
      </m:deg>
      <m:e>
        <m:r>
          <m:t>8</m:t>
        </m:r>
      </m:e>
    </m:rad>
    <m:r>
      <m:t>⋅</m:t>
    </m:r>
    <m:acc>
      <m:accPr>
        <m:chr m:val="⃗"/>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:accPr>
      <m:e>
        <m:r>
          <m:t>v</m:t>
        </m:r>
      </m:e>
    </m:acc>
    <m:bar>
      <m:barPr>
        <m:pos m:val="top"/>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:barPr>
      <m:e>
        <m:r>
          <m:t>z</m:t>
        </m:r>
      </m:e>
    </m:bar>
    <m:sSubSup>
      <m:sSubSupPr>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:sSubSupPr>
      <m:e>
        <m:r>
          <m:rPr>
            <m:scr m:val="double-struck"/>
            <m:sty m:val="p"/>
          </m:rPr>
          <m:t>R</m:t>
        </m:r>
      </m:e>
      <m:sub>
        <m:r>
          <m:t>+</m:t>
        </m:r>
      </m:sub>
      <m:sup>
        <m:r>
          <m:t>n</m:t>
        </m:r>
      </m:sup>
    </m:sSubSup>
  </m:oMath>
  <m:oMath>
    <m:d>
      <m:dPr>
        <m:begChr m:val="["/>
        <m:endChr m:val="]"/>
        <m:ctrlPr>
          <w:rPr>
            <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
            <w:i/>
          </w:rPr>
        </m:ctrlPr>
      </m:dPr>
      <m:e>
        <m:m>
          <m:mPr>
            <m:mcs>
              <m:mc>
                <m:mcPr>
                  <m:count m:val="2"/>
                  <m:mcJc m:val="center"/>
                </m:mcPr>
              </m:mc>
            </m:mcs>
            <m:ctrlPr>
              <w:rPr>
                <w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"/>
                <w:i/>
              </w:rPr>
            </m:ctrlPr>
          </m:mPr>
          <m:mr>
            <m:e>
              <m:r>
                <m:t>a</m:t>
              </m:r>
            </m:e>
            <m:e>
              <m:r>
                <m:t>b</m:t>
              </m:r>
            </m:e>
          </m:mr>
          <m:mr>
            <m:e>
              <m:r>
                <m:t>c</m:t>
              </m:r>
            </m:e>
            <m:e>
              <m:r>
                <m:t>d</m:t>
              </m:r>
            </m:e>
          </m:mr>
        </m:m>
      </m:e>
    </m:d>
  </m:oMath>
</m:oMathPara>
